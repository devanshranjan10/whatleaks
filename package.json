{
  "name": "whatleaks",
  "version": "0.1.0",
  "description": "See what an app you run sends home: where, how often, which fields, with payload samples, and what it still sends after you opt out of telemetry.",
  "type": "module",
  "license": "MIT",
  "author": "Devansh Ranjan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devanshranjan10/whatleaks.git"
  },
  "homepage": "https://github.com/devanshranjan10/whatleaks#readme",
  "bugs": {
    "url": "https://github.com/devanshranjan10/whatleaks/issues"
  },
  "bin": {
    "whatleaks": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "telemetry",
    "privacy",
    "audit",
    "har",
    "proxy",
    "opt-out",
    "do-not-track",
    "cli"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "mockttp": "4.6.4",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "basic-ftp": "^6.2.3"
  }
}
